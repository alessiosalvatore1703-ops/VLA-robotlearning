#!/usr/bin/env python3
"""Small MolmoAct2 inference server for remote SO100/SO101 action prediction.

The server receives base64-encoded RGB images, a 6D robot state, and a language
instruction. It returns a continuous action chunk predicted by MolmoAct2.

It does not execute actions on the robot. Keep robot control on the local
machine that is physically connected to the arm.
"""

from __future__ import annotations

import argparse
import base64
import io
import traceback
from contextlib import nullcontext

import numpy as np
import torch
from fastapi import FastAPI, HTTPException
from PIL import Image
from pydantic import BaseModel, Field
from transformers import AutoModelForImageTextToText, AutoProcessor


DEFAULT_REPO_ID = "allenai/MolmoAct2-SO100_101"
DEFAULT_NORM_TAG = "so100_so101_molmoact2"


class ActRequest(BaseModel):
    task: str
    state: list[float] = Field(..., min_length=6, max_length=6)
    images: list[str] = Field(..., min_length=1)
    num_steps: int = 10
    normalize_language: bool = True


class ActResponse(BaseModel):
    actions: list[list[float]]
    shape: list[int]
    repo_id: str
    norm_tag: str
    dtype: str


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo-id", default=DEFAULT_REPO_ID)
    parser.add_argument("--norm-tag", default=DEFAULT_NORM_TAG)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=8000)
    parser.add_argument("--device", default="cuda")
    parser.add_argument(
        "--dtype",
        choices=["bfloat16", "float16", "float32"],
        default="bfloat16",
        help="Use bfloat16 on normal Brev GPUs. float32 needs much more VRAM.",
    )
    parser.add_argument(
        "--disable-cuda-graph",
        action="store_true",
        help="Disable CUDA graph capture. This uses less VRAM but is slower.",
    )
    return parser.parse_args()


def torch_dtype(name: str) -> torch.dtype:
    if name == "bfloat16":
        return torch.bfloat16
    if name == "float16":
        return torch.float16
    if name == "float32":
        return torch.float32
    raise ValueError(f"Unsupported dtype: {name}")


def decode_image(encoded: str) -> Image.Image:
    if "," in encoded and encoded.split(",", 1)[0].startswith("data:image/"):
        encoded = encoded.split(",", 1)[1]

    try:
        raw = base64.b64decode(encoded, validate=True)
        return Image.open(io.BytesIO(raw)).convert("RGB")
    except Exception as exc:
        raise HTTPException(status_code=400, detail=f"Invalid base64 image: {exc}") from exc


def create_app(args: argparse.Namespace) -> FastAPI:
    dtype = torch_dtype(args.dtype)
    device = torch.device(args.device)

    if device.type == "cuda" and not torch.cuda.is_available():
        raise RuntimeError("CUDA was requested but torch.cuda.is_available() is false.")

    processor = AutoProcessor.from_pretrained(args.repo_id, trust_remote_code=True)
    model = AutoModelForImageTextToText.from_pretrained(
        args.repo_id,
        trust_remote_code=True,
        dtype=dtype,
    ).to(device).eval()

    app = FastAPI(title="MolmoAct2 SO100/SO101 inference server")

    @app.get("/health")
    def health() -> dict[str, str | bool]:
        return {
            "status": "ok",
            "repo_id": args.repo_id,
            "norm_tag": args.norm_tag,
            "dtype": args.dtype,
            "device": str(device),
            "cuda_graph": not args.disable_cuda_graph,
        }

    @app.get("/act")
    def act_get() -> dict[str, str]:
        return {"status": "ok", "message": "Use POST /act for action prediction."}

    @app.post("/act", response_model=ActResponse)
    def act(req: ActRequest) -> ActResponse:
        images = [decode_image(item) for item in req.images]
        state = np.asarray(req.state, dtype=np.float32)

        if state.shape != (6,):
            raise HTTPException(status_code=400, detail=f"Expected state shape (6,), got {state.shape}.")

        use_amp = device.type == "cuda" and dtype in {torch.bfloat16, torch.float16}
        amp_context = torch.autocast("cuda", dtype=dtype) if use_amp else nullcontext()

        try:
            with torch.inference_mode(), amp_context:
                out = model.predict_action(
                    processor=processor,
                    images=images,
                    task=req.task,
                    state=state,
                    norm_tag=args.norm_tag,
                    action_mode="continuous",
                    enable_depth_reasoning=False,
                    num_steps=req.num_steps,
                    normalize_language=req.normalize_language,
                    enable_cuda_graph=not args.disable_cuda_graph,
                )

            raw_actions = out.actions
            if isinstance(raw_actions, torch.Tensor):
                actions = raw_actions.detach().cpu().float().numpy()
            else:
                actions = np.asarray(raw_actions, dtype=np.float32)

            return ActResponse(
                actions=actions.tolist(),
                shape=list(actions.shape),
                repo_id=args.repo_id,
                norm_tag=args.norm_tag,
                dtype=args.dtype,
            )
        except Exception as exc:
            traceback.print_exc()
            raise HTTPException(status_code=500, detail=f"MolmoAct2 prediction failed: {exc}") from exc

    return app


def main() -> None:
    args = parse_args()

    import uvicorn

    app = create_app(args)
    uvicorn.run(app, host=args.host, port=args.port)


if __name__ == "__main__":
    main()
